# Served by Cloudflare Pages. The portfolio header floor is six items (see the
# portfolio CLAUDE.md); tests/site.test.mjs checks this FILE has them, and
# `curl -sI https://feelingthemachine.com/` is the only check of what is SERVED.
# A `_headers` file is not evidence.
#
# EXACTLY ONE RULE PER PATH. Pages silently does not merge two rules with the
# identical path; add a header to the block that exists.

/fonts/*
  # A different path from `/*`, so Pages merges it with the block below. Font
  # files change only when scripts/subset_han.sh or a Fontsource upgrade
  # rewrites them; a month of caching is safe, and a stale glyph set only
  # falls back to the system's Chinese serif.
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# NOTHING IS LOADED FROM ANY OTHER ORIGIN. Google Fonts was the last third
# party and left on 2026-11-20; the fonts are in /fonts/. A new external
# source is a change to the privacy policy first and to this line second.
#
# NO 'unsafe-inline' ANYWHERE: the page's <style> and <script> were moved to
# site.css and site.js so the policy could stay shut. A style attribute or
# inline handler added to index.html will be silently refused.
#
# `form-action 'none'`: the site has no forms on purpose (the panel signs up by
# email). Participant accounts would change this, and much of the rest.
#
# NO `preload` ON HSTS. Preloading is a commitment that is slow to undo, and a
# new domain should earn it after the subdomains it will need are known.
